# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: Discord webhook for the team channel
DISCORD_WEBHOOK_URL=
# Optional: AI summaries (Claude or OpenRouter), server side only
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: a Sheet id where the server keeps a private copy of its state (no positions), for hosts that wipe the disk on restart
STATE_SHEET_ID=
# Speech to text for voice clues, server side only
ASSEMBLYAI_API_KEY=
# Google Sheet (service account JSON path) for job sheet in and debrief out
GOOGLE_SERVICE_ACCOUNT_FILE=
PORT=8787
# Public https address of this server (webhook, dashboard, real glasses)
PUBLIC_URL=
# Discord reply buttons (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
# Discord user ids allowed to press the reply buttons, comma separated. Empty means nobody can.
DISCORD_COORDINATOR_IDS=
# Dev only (needs CALLOUT_DEV=1): shorten the notice timers, in seconds, to see them quickly
# DEV_CHECKIN_S=40
# DEV_GRACE1_S=15
# DEV_GRACE2_S=25
# DEV_SILENT_S=120
